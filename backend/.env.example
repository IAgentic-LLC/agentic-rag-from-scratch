# ---- Default: Gemini -------------------------------------------------------
GOOGLE_API_KEY=your-gemini-key
CHAT_MODEL=google_genai:gemini-3.8-flash
FAST_MODEL=google_genai:gemini-3.5-flash-lite
EMBED_MODEL=google:gemini-embedding-001
# Eval judge (ideally a different provider from CHAT_MODEL): JUDGE_MODEL=deepseek:deepseek-flash

# ---- Swap the chat models by changing two lines (CHAT_MODEL and FAST_MODEL) ------------------------------
# DeepSeek:  CHAT_MODEL=deepseek:deepseek-flash   FAST_MODEL=deepseek:deepseek-flash   DEEPSEEK_API_KEY=...
# Qwen:      CHAT_MODEL=qwen:qwen3.8-flash           FAST_MODEL=qwen:qwen3.8-flash           DASHSCOPE_API_KEY=...
# OpenAI:    CHAT_MODEL=openai:gpt-5.4-mini          FAST_MODEL=openai:gpt-5.4-mini          OPENAI_API_KEY=...
# Claude:    CHAT_MODEL=anthropic:claude-sonnet-5-5  FAST_MODEL=anthropic:claude-haiku-5-5   ANTHROPIC_API_KEY=...
# Local:     CHAT_MODEL=local:qwen3.8-27b            (Ollama on http://localhost:11434/v1)
#
# Mixing is fine and often smart: a cheap FAST_MODEL for routing and grading, a stronger CHAT_MODEL for answers.
# Claude and DeepSeek have no embeddings API: keep EMBED_MODEL on Gemini or OpenAI.
# If you change EMBED_MODEL, run `python ingest.py` again (vectors from different models don't mix).
# Qwen region: set QWEN_BASE_URL if your DashScope key is not for Singapore (ap-southeast-1).
